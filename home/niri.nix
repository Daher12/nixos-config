{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.desktop.niri;

  # Panel definition — the same shared list the Hyprland session and
  # battery-refresh read (hosts/yoga/home.nix, "panel definition for BOTH
  # sessions"). Scale and resolution are carried into the niri config; niri
  # picks the refresh rate itself from the resolution-only mode (highest
  # available). battery-refresh manages the actual rate per power state.
  monitors = config.desktop.hyprland.monitors;
  panel = if monitors == [ ] then null else builtins.head monitors;
  outputKdl =
    if panel == null then
      ""
    else
      let
        # Resolution part of the shared mode ("3072x1920@120" -> "3072x1920").
        # An omitted mode is NOT an option: niri then takes the panel's
        # PREFERRED timing, and this EDID pins preferred at 60 Hz — the
        # resolution-only form is what selects the 120.002 Hz mode.
        wxh = builtins.head (builtins.match "(.+)@[0-9.]+" panel.mode);
      in
      ''
        output "${panel.output}" {
            // Resolution-only mode: niri picks the highest refresh rate for
            // it (shared panel definition: ${panel.mode}).
            mode "${wxh}"
            scale ${panel.scale}
        }
      '';

  niriKdl = ''
    // Generated by home-manager from home/niri.nix — do not edit.
    // niri 26.04 scrollable-tiling config (wiki: niri-wm.github.io/niri).
    // Binds mirror the Hyprland muscle memory (home/hyprland.nix + the
    // live ~/.config/lucid/keybinds.json); shell surfaces go through
    // Noctalia IPC (`noctalia msg …`, upstream niri recipe:
    // docs.noctalia.dev/noctalia/compositor-settings/niri), compositor
    // actions through niri itself.

    // Lucid named-workspace habits: the magic scratchpad and the
    // music/comms/todo jump targets (keybinds.json SUPER+SHIFT+M/D/R).
    // Named workspaces always exist, even empty.
    workspace "magic"
    workspace "music"
    workspace "comms"
    workspace "todo"

    input {
        keyboard {
            xkb {
                // Fleet keymap (modules/core/locale.nix, Hyprland parity):
                // German primary, US fallback, ALT+SHIFT switches.
                layout "de,us"
                variant "nodeadkeys,"
                options "grp:alt_shift_toggle"
            }
        }
        touchpad {
            tap
            natural-scroll
        }
    }

    // Session cursor (home/theme.nix parity: Posy black, 32px). Without
    // this block niri falls back to its built-in 24px default AND exports
    // XCURSOR_SIZE=24 to spawned apps, clobbering the home/theme.nix
    // session env — that shrink is why this block exists (2026-11-07).
    cursor {
        xcursor-theme "Posy_Cursor_Black"
        xcursor-size 32
    }

    ${outputKdl}

    layout {
        // Hyprland gaps_out parity (niri has a single gap value,
        // in == out).
        gaps 12
        center-focused-column "never"
        default-column-width { proportion 0.5; }

        // Active-only ring: Rosé Pine iris (the shell palette,
        // home/noctalia.nix) on the focused window, invisible everywhere
        // else — rounding + shadows carry the unfocused look. Width 1 and
        // 60% alpha: full-strength iris at width 2 read too loud against
        // light wallpapers (round 5, 2026-11-07).
        focus-ring {
            width 1
            active-color "#c4a7e799"
            inactive-color "#00000000"
        }
        border {
            off
        }

        // Hyprland decoration.shadow parity (range 24 -> softness 24).
        shadow {
            on
            softness 24
            spread 5
            offset x=0 y=5
            color "#0007"
        }
    }

    // Drop client-side decorations so the focus ring draws around windows
    // and the corner-radius rule below applies cleanly.
    prefer-no-csd

    // Material 3 corner radius (Hyprland rounding 16) on every window.
    window-rule {
        geometry-corner-radius 16
        clip-to-geometry true
    }

    // NOTE: no rule-forced blur for kitty — kitty ≥0.46.2 (we run 0.49.1)
    // requests the effect itself via ext-background-effect (background_blur
    // in home/terminal.nix), which niri renders correctly in every state.
    // The forced `xray false` path (non-xray blur, experimental in 26.04
    // with known limitations) rendered the FOCUSED window fully opaque
    // while unfocused kitties frosted — 2026-11-07.

    // Window-open policy: every window opens as a MAXIMIZED COLUMN — the
    // full working area minus struts AND gaps (niri: "maximized columns
    // still leave space for struts and gaps"), i.e. generous but never
    // edge-to-edge. One GLOBAL rule — a rule without `match` applies to
    // every window. `open-maximized-to-edges false` stays alongside:
    // self-sizing toolkits (Firefox/GTK, Nautilus/GTK4, Electron/ZCode)
    // restore "maximized" from their own profiles (xulstore, Electron
    // storage) and request xdg-maximized at map, and a GRANTED request is
    // niri's maximize-to-edges state — genuinely edge-to-edge, bar only,
    // no gaps — so the request is denied (niri >= 25.11). Fullscreen stays
    // available on demand (Mod+F); `open-fullscreen` is deliberately unset
    // so games and mpv keep their legitimate fullscreen requests.
    window-rule {
        open-maximized true
        open-maximized-to-edges false
    }

    // Terminal exception (the wiki's own "all windows maximized, Alacritty
    // not" shape — later rules override earlier fields): kitty opens at
    // the layout default-column-width (half width); Mod+Shift+F
    // (maximize-column) toggles the full width when a terminal needs it.
    window-rule {
        match app-id=r#"^kitty$"#
        open-maximized false
    }

    // App float rules (Hyprland parity — app-id instead of class on
    // Wayland).
    window-rule {
        match app-id=r#"^org\.gnome\.FileRoller$"#
        open-floating true
    }
    window-rule {
        match app-id=r#"^org\.gnome\.Loupe$"#
        open-floating true
    }
    // Firefox Bitwarden popup (German-locale title).
    window-rule {
        match app-id=r#"firefox$"# title=r#"^Erweiterung: .*Bitwarden.*$"#
        open-floating true
    }
    // Firefox picture-in-picture floats.
    window-rule {
        match app-id=r#"firefox$"# title=r#"^Picture-in-Picture$"#
        open-floating true
    }
    // Noctalia's settings window (upstream niri recipe: floating, fixed
    // 1080x920).
    window-rule {
        match app-id=r#"^dev\.noctalia\.Noctalia$"#
        open-floating true
        default-column-width { fixed 1080; }
        default-window-height { fixed 920; }
    }

    // Notification actions and window activation from Noctalia (upstream
    // niri recipe — Noctalia's activation tokens carry no valid serial).
    debug {
        honor-xdg-activation-with-invalid-serial
    }

    // Blurred overview (upstream niri recipe, option 1): Noctalia's
    // dedicated backdrop layer (backdrop.enabled in home/noctalia.nix)
    // sits within niri's overview backdrop.
    layer-rule {
        match namespace=r#"^noctalia-backdrop"#
        place-within-backdrop true
    }

    // Shell surfaces: compositor blur where the surface is solid (panels,
    // launcher, control center, toasts, OSD, desktop widget cards, window
    // switcher) — the frosted-glass look. The BAR and the DOCK get NO
    // explicit `blur true`: both surfaces are full-width rectangles and the
    // rule value is the fallback when the client publishes NO blur region —
    // i.e. exactly when the bar pill / dock is hidden — so forcing blur
    // there frosts the invisible full-width strip and blocks the windows
    // beneath (the dock-blur-while-hidden bug, 2026-11-06). Their frost
    // comes from Noctalia's own pill-shaped blur regions via
    // ext-background-effects; niri renders client regions on its own
    // (src/render_helpers/background_effect.rs: a region enables blur
    // unless the rule says `blur false`). `xray false` everywhere: unset
    // xray defaults to true in niri and bleeds wallpaper pixels at corners.
    layer-rule {
        match namespace=r#"^noctalia-(bar-[^"]+|notification|dock|panel|attached-panel|osd|desktop-widget-[^"]+)$"#
        background-effect {
            xray false
        }
    }
    layer-rule {
        match namespace=r#"^noctalia-(notification|panel|attached-panel|osd|desktop-widget-[^"]+|window-switcher)$"#
        background-effect {
            blur true
            xray false
        }
    }

    // Overview: tiles near full size (zoom close to 1) so the blurred
    // Noctalia backdrop shows between fewer, bigger windows.
    overview {
        zoom 0.9
    }

    // Global blur tuning (niri defaults: passes 3, offset 3.0, noise 0.02,
    // saturation 1.5). Mirrors the Hyprland frost home/hyprland.nix ran
    // (size 10, passes 2, noise 0.04) — offset ~= size/2 — with saturation
    // pinned to 1.0 so the glass stays neutral (niri's 1.5 default boosts
    // wallpaper colors through the frost).
    blur {
        passes 2
        offset 5.0
        noise 0.04
        saturation 1.0
    }

    // German user dirs (hosts/yoga/home.nix).
    screenshot-path "~/Bilder/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

    // Animations: window open/close are Lucid-parity (home/hyprland.nix):
    // decelerating entry (~220ms ease-out), quicker exit. The springs for
    // workspace/column/window motion get a softer settle than niri's
    // defaults (slightly underdamped, damping-ratio 0.9), resize/overview
    // take the same eased feel as the open/close curves; the shell's own
    // animations run at 1.15 in home/noctalia.nix so both systems read at
    // a similar pace. Schema per niri 26.04: one `overview-open-close`
    // node (open/close split was merged), `horizontal-view-shift` is gone.
    animations {
        window-open {
            duration-ms 220
            curve "ease-out-expo"
        }
        window-close {
            duration-ms 150
            curve "ease-out-quad"
        }
        window-resize {
            duration-ms 150
            curve "ease-out-quad"
        }
        overview-open-close {
            duration-ms 250
            curve "ease-out-expo"
        }
        workspace-switch {
            spring damping-ratio=0.9 stiffness=400 epsilon=0.0001
        }
        window-movement {
            spring damping-ratio=0.9 stiffness=400 epsilon=0.0001
        }
        horizontal-view-movement {
            spring damping-ratio=0.9 stiffness=400 epsilon=0.0001
        }
    }

    binds {
        // NOTE: a custom `binds {}` block REPLACES niri's shipped default
        // bind set entirely — `Binds::default()` in code is empty and the
        // loader never merges default-config.kdl into a user config (the
        // wiki: binds "does not get automatically filled with defaults").
        // Everything the defaults carried (Mod+Q close, the SUPER+wheel
        // workspace/column scroll set, ...) must therefore be spelled out
        // here, alongside the ported lucid/Hyprland habits.

        // niri default-set wheel binds (also the keybinds.json SUPER+wheel
        // habits): workspace scroll + column focus/move.
        Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
        Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
        Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
        Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
        Mod+WheelScrollRight { focus-column-right; }
        Mod+WheelScrollLeft { focus-column-left; }

        // niri default close bind (lucid SUPER+Q habit).
        Mod+Q repeat=false hotkey-overlay-title="Close window" { close-window; }

        // Emoji picker (keybinds.json SUPER+period): the launcher's emoji
        // provider triggers on the "/emo" prefix, and a panel-toggle
        // context is typed into the launcher input.
        Mod+Period hotkey-overlay-title="Emoji picker" { spawn "noctalia" "msg" "panel-toggle" "launcher" "/emo"; }

        // NOTE: no Mod+Shift+Slash bind — on the de layout niri also fires
        // it as Mod+Shift+7 (the DMS trial's doctor warned about exactly
        // this), so show-hotkey-overlay has no bind here.

        // Apps & shell surfaces — Noctalia IPC verb form per
        // docs.noctalia.dev/noctalia/ipc (panel ids: launcher, session,
        // clipboard, control-center [tab]).
        Mod+T hotkey-overlay-title="Terminal: kitty" { spawn "kitty"; }
        Mod+Shift+E hotkey-overlay-title="Files: nautilus" { spawn "nautilus"; }
        Mod+F1 hotkey-overlay-title="Browser: firefox" { spawn "firefox"; }
        Mod+R hotkey-overlay-title="Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
        Mod+Space hotkey-overlay-title="Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
        Mod+P hotkey-overlay-title="Session menu" { spawn "noctalia" "msg" "panel-toggle" "session"; }
        Mod+L hotkey-overlay-title="Lock screen" { spawn "noctalia" "msg" "session" "lock"; }
        Mod+Tab repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
        Mod+O repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
        Mod+V hotkey-overlay-title="Clipboard" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
        Mod+N hotkey-overlay-title="Notifications" { spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
        Mod+M hotkey-overlay-title="Process info: btop" { spawn "kitty" "-e" "btop"; }
        Mod+Comma hotkey-overlay-title="Noctalia settings" { spawn "noctalia" "msg" "settings-toggle"; }
        // Lucid habit moved off tap-SUPER per user request (2026-11-06):
        // SUPER+Z opens the launcher; Mod+R/Space stay as alternates.
        Mod+Z repeat=false hotkey-overlay-title="Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
        // Lucid habits from keybinds.json (SUPER+C close, SUPER+E files,
        // SUPER+B wallpaper picker, SUPER+W workspace overview). C/W
        // override niri defaults (center-column / tabbed-display); D
        // overrides the fuzzel launcher (not installed) with the region
        // screenshot. Mod+Q close is bound above — a custom binds block
        // replaces niri's defaults, so it is NOT automatic.
        Mod+C hotkey-overlay-title="Close window" { close-window; }
        Mod+E hotkey-overlay-title="Files: nautilus" { spawn "nautilus"; }
        Mod+B hotkey-overlay-title="Wallpaper picker" { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
        Mod+W repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
        Mod+D hotkey-overlay-title="Screenshot (region)" { screenshot; }
        Mod+Print hotkey-overlay-title="Screenshot (screen)" { screenshot-screen; }
        // System monitor workspace habit (CTRL+SHIFT+Escape in
        // keybinds.json).
        Ctrl+Shift+Escape hotkey-overlay-title="Process info: btop" { spawn "kitty" "-e" "btop"; }

        // Scratchpad + named jump targets (lucid keybinds.json
        // SUPER+S / SUPER+SHIFT+S magic stash, SUPER+SHIFT+M/D/R). The
        // niri analog of the magic special workspace is a named workspace.
        Mod+S hotkey-overlay-title="Scratchpad (magic)" { focus-workspace "magic"; }
        Mod+Shift+S hotkey-overlay-title="Stash to magic" { move-column-to-workspace "magic"; }
        Mod+Shift+M hotkey-overlay-title="Music workspace" { focus-workspace "music"; }
        Mod+Shift+D hotkey-overlay-title="Comms workspace" { focus-workspace "comms"; }
        Mod+Shift+R hotkey-overlay-title="To-do workspace" { focus-workspace "todo"; }

        // Noctalia window switcher (hold = stays open while Alt is held,
        // picks on release); niri's own switcher is not bound.
        Alt+Tab repeat=false hotkey-overlay-title="Window switcher" { spawn "noctalia" "msg" "window-switcher" "hold"; }
        Alt+Shift+Tab repeat=false hotkey-overlay-title="Window switcher (reverse)" { spawn "noctalia" "msg" "window-switcher" "hold" "reverse"; }

        // Focus (Hyprland parity; SUPER+J/K step through the focused
        // column — the niri analog of Hyprland's SUPER+J split toggle).
        Mod+Left  { focus-column-left; }
        Mod+Right { focus-column-right; }
        Mod+Up    { focus-window-up; }
        Mod+Down  { focus-window-down; }
        Mod+J     { focus-window-down; }
        Mod+K     { focus-window-up; }

        // Move within the column.
        Mod+Ctrl+Left  { move-column-left; }
        Mod+Ctrl+Right { move-column-right; }
        Mod+Ctrl+Up    { move-window-up; }
        Mod+Ctrl+Down  { move-window-down; }

        // Column in/out (niri-native consume/expel — stands in for the
        // Hyprland group binds).
        Mod+BracketLeft  { consume-or-expel-window-left; }
        Mod+BracketRight { consume-or-expel-window-right; }

        // Workspaces 1-9: SUPER+N focus, SUPER+SHIFT+N move (lucid
        // keybinds.json parity — NOT the niri-default SUPER+CTRL+N).
        Mod+1 { focus-workspace 1; }
        Mod+2 { focus-workspace 2; }
        Mod+3 { focus-workspace 3; }
        Mod+4 { focus-workspace 4; }
        Mod+5 { focus-workspace 5; }
        Mod+6 { focus-workspace 6; }
        Mod+7 { focus-workspace 7; }
        Mod+8 { focus-workspace 8; }
        Mod+9 { focus-workspace 9; }
        Mod+Shift+1 { move-column-to-workspace 1; }
        Mod+Shift+2 { move-column-to-workspace 2; }
        Mod+Shift+3 { move-column-to-workspace 3; }
        Mod+Shift+4 { move-column-to-workspace 4; }
        Mod+Shift+5 { move-column-to-workspace 5; }
        Mod+Shift+6 { move-column-to-workspace 6; }
        Mod+Shift+7 { move-column-to-workspace 7; }
        Mod+Shift+8 { move-column-to-workspace 8; }
        Mod+Shift+9 { move-column-to-workspace 9; }

        // Older Hyprland habit: ALT+N moves the window to workspace N (bare
        // ALT is otherwise unused — Alt+Tab is the window switcher).
        Alt+1 { move-column-to-workspace 1; }
        Alt+2 { move-column-to-workspace 2; }
        Alt+3 { move-column-to-workspace 3; }
        Alt+4 { move-column-to-workspace 4; }
        Alt+5 { move-column-to-workspace 5; }
        Alt+6 { move-column-to-workspace 6; }
        Alt+7 { move-column-to-workspace 7; }
        Alt+8 { move-column-to-workspace 8; }
        Alt+9 { move-column-to-workspace 9; }

        // Window states (Hyprland parity: SUPER+F fullscreen,
        // SUPER+SHIFT+V float — SUPER+V is the clipboard here, so niri's
        // default float bind moves to Shift). SUPER+SHIFT+F toggles the
        // maximized column (full width within the gaps — the open-policy
        // state above; the terminal's way up from half width). niri's own
        // defaults have these two swapped (Mod+F maximize, Mod+Shift+F
        // fullscreen) — the Hyprland habit wins.
        Mod+F { fullscreen-window; }
        Mod+Shift+F hotkey-overlay-title="Maximize column" { maximize-column; }
        // Escape hatch out of the edge-to-edge state (toggle). niri's own
        // default for this action is Mod+M, owned by btop here. Apps that
        // self-maximize after mapping (zcode — see zcode-unmax below) land
        // there; exiting normally returns a maximized column.
        Mod+Ctrl+F hotkey-overlay-title="Maximize to edges (toggle)" { maximize-window-to-edges; }
        Mod+Shift+V { toggle-window-floating; }

        // Width/height nudges (niri defaults).
        Mod+Minus { set-column-width "-10%"; }
        Mod+Equal { set-column-width "+10%"; }
        Mod+Shift+Minus { set-window-height "-10%"; }
        Mod+Shift+Equal { set-window-height "+10%"; }

        // Screenshots (niri built-in UI). Noctalia's own tooling is a
        // bind away if wanted: `noctalia msg screenshot-region --annotate`.
        Print { screenshot; }
        Ctrl+Print { screenshot-screen; }
        Alt+Print { screenshot-window; }

        // Session exit back to the greeter. (SUPER+SHIFT+E is the file
        // manager here — Hyprland parity — so niri's default quit bind
        // lives on Ctrl+Alt+Delete.)
        Ctrl+Alt+Delete { quit; }

        // Escape hatch for keyboard-shortcut inhibitors (remote-desktop
        // sessions holding the binds hostage).
        Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

        // XF86 media/brightness (keybinds.json parity; brightness keeps
        // the user-chosen 10% linear steps, 2026-11-01).
        XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "pactl set-sink-volume @DEFAULT_SINK@ +5%"; }
        XF86AudioLowerVolume allow-when-locked=true { spawn-sh "pactl set-sink-volume @DEFAULT_SINK@ -5%"; }
        XF86AudioMute allow-when-locked=true { spawn-sh "pactl set-sink-mute @DEFAULT_SINK@ toggle"; }
        XF86AudioMicMute allow-when-locked=true { spawn-sh "pactl set-source-mute @DEFAULT_SOURCE@ toggle"; }
        XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
        XF86AudioPause allow-when-locked=true { spawn-sh "playerctl play-pause"; }
        XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }
        XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
        XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "-n2" "set" "10%+"; }
        XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-n2" "set" "10%-"; }
    }
  '';

  # Build-time gate: niri validate parses the whole config (KDL syntax,
  # action names, include semantics). A broken config fails the
  # dry-build/rebuild instead of dying at first login.
  niriConfig = pkgs.runCommand "niri-config.kdl" { nativeBuildInputs = [ pkgs.niri ]; } ''
    printf '%s\n' ${lib.escapeShellArg niriKdl} > $out
    niri validate -c $out
  '';

  # zcode (Electron) restores its saved window state MAXIMIZED after the
  # window maps, and niri grants post-map maximize requests
  # unconditionally (src/handlers/xdg_shell.rs maximize_request(): plain
  # layout.set_maximized(), no window-rule gate) — the
  # open-maximized-to-edges=false deny only covers the initial configure,
  # which is why Firefox (asks at map) stays a maximized column while
  # zcode lands edge-to-edge. The wrapper launches zcode unchanged, waits
  # until a NEW zcode window actually reaches the to-edges state, then
  # trades it for a maximized column (full width, gaps kept). The width
  # probe is the race guard: a maximized column keeps the layout gaps, so
  # tile >= width-6 can only be to-edges.
  zcodeUnmax = pkgs.writeShellScriptBin "zcode-unmax" ''
    set -u
    before=$(niri msg -j windows | jq '[.[].id]')
    zcode "$@" >/dev/null 2>&1 &

    w=$(niri msg -j outputs | jq -r '[.[] | select(.logical).logical.width] | max')
    id=
    for _ in $(seq 1 150); do
      sleep 0.1
      id=$(niri msg -j windows \
        | jq -r --argjson w "$w" --argjson before "$before" '
            .[]
            | select(.app_id == "zcode")
            | select(.layout.tile_size[0] >= ($w - 6))
            | .id as $i | select(($before | index($i)) == null)
            | .id' \
        | head -n1)
      [ -n "$id" ] && break
    done
    [ -n "$id" ] || exit 0
    niri msg action maximize-window-to-edges --id "$id"
    sleep 0.3
    # Exiting to-edges normally lands in a maximized column already; if it
    # came back unmaximized (seen once live), cycle it on.
    tile=$(niri msg -j windows \
      | jq -r --argjson w "$w" --argjson id "$id" \
        '.[] | select(.id == $id) | .layout.tile_size[0]')
    if jq -ne --argjson t "$tile" --argjson w "$w" '$t < ($w - 30)' >/dev/null 2>&1; then
      niri msg action maximize-column --id "$id"
    fi
  '';
in
{
  options.desktop.niri = {
    enable = lib.mkEnableOption ''
      niri session config (KDL, validated at build time). Pair with
      features.desktop-niri on the NixOS side; the Noctalia shell rides
      home/noctalia.nix
    '';
  };

  config = lib.mkIf cfg.enable {
    # Store symlink, re-linked by the HM activation every boot; nothing
    # writes next to it (Noctalia's builtin `niri`/`kitty` template ids are
    # off — they would try to rewrite Nix-owned files, see
    # home/noctalia.nix).
    xdg.configFile."niri/config.kdl".source = niriConfig;

    home.packages = [ zcodeUnmax ];

    # Route the desktop entry (owned by hosts/yoga/home.nix, which keeps
    # the plain `zcode` exec on the Hyprland/GNOME attrs) through the
    # un-maximize wrapper; the terminal `zcode` stays untouched.
    xdg.desktopEntries.zcode.exec = lib.mkForce "zcode-unmax --no-sandbox %U";
  };
}
