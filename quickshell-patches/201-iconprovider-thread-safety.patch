+QPixmap
+IconImageProvider::requestPixmap(const QString& id, QSize* size, const QSize& requestedSize) {
+	auto* app = QCoreApplication::instance();
+
+	// Synchronous requests are made on the gui thread already — run inline.
+	if (app == nullptr || QThread::currentThread() == app->thread()) {
+		return requestPixmapInGuiThread(id, size, requestedSize);
+	}
+
+	// Off the gui thread: execute ON the gui thread and block until done.
+	// This cannot deadlock — the gui thread's own requests run inline (no
+	// hop) and it never waits on the reader thread. A plain mutex was tried
+	// first and is NOT sufficient: serializing the entry keeps cross-thread
+	// pixmap creation illegal, and Qt's internal gui-thread dispatches then
+	// deadlock against the serialized requests (the first attempt wedged
+	// the reader thread with every later icon request queued behind it,
+	// silently rendering only fallback icons; reverted same day).
+	QPixmap pixmap;
+	QMetaObject::invokeMethod(
+	    app,
+	    [&]() { pixmap = requestPixmapInGuiThread(id, size, requestedSize); },
+	    Qt::BlockingQueuedConnection
+	);
+	return pixmap;
+}
